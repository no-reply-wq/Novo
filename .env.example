# ─────────────────────────────────────────────────────────────
# Novo — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string.
# The user must have CREATE SCHEMA and CREATE TABLE privileges.
DATABASE_URL=postgresql://novo:novo@localhost:5432/novo

# ── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-me-with-32-hex-chars

# The public URL of this deployment (no trailing slash).
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ── Multi-tenancy ─────────────────────────────────────────────
# Used to sign portal tokens (customer-facing login).
# Generate with: openssl rand -hex 32
PLATFORM_SECRET=replace-me-with-32-hex-chars

# The root domain. Tenant subdomains are <slug>.<BASE_DOMAIN>.
BASE_DOMAIN=your-domain.com

# ── Email / SMTP (password reset, notifications) ──────────────
# Without these, forgot-password silently skips sending.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Novo <no-reply@example.com>"

# ── File storage (S3-compatible) ──────────────────────────────
# Used for PDF attachments, file upload fields, barcode labels.
# Leave blank to disable storage features.
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=novo-files
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
# Public base URL for stored files (CDN or bucket public URL)
STORAGE_PUBLIC_URL=https://files.your-domain.com

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────
# Optional — only needed if using the WhatsApp integration.
# Configure per-tenant via the builder Integrations → WhatsApp page.
# WHATSAPP_VERIFY_TOKEN is used to verify the webhook from Meta.
WHATSAPP_VERIFY_TOKEN=replace-me

# ── Google Maps / Geocoding (optional) ───────────────────────
# Used by GPS capture fields.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
